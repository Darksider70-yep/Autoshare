# ==============================================================================
# Autoshare Platform - Git Ignore Configuration
# Full-Stack: Spring Boot 3 (Maven) + React 19 (Vite 6)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 2. Java & Maven Build Outputs
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven Logs & Surefire Reports
*.log
**/surefire-reports/
**/maven-status/

# H2 Database files (if persistent file mode is used)
*.mv.db
*.trace.db

# ------------------------------------------------------------------------------
# 3. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath

# ------------------------------------------------------------------------------
# 4. OS-Specific & Office Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
*~
~$*.docx
~$*.xlsx
~$*.pptx

# ------------------------------------------------------------------------------
# 5. Python Cache & Scratch Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.json.bak
extracted_page_numbers.json
fast_page_check.json
temp_terminal.html
temp_term_*.html
